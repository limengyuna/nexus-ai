# NexusAI 环境变量模板
# 用法：cp .env.example .env 后填入你的真实 key

# ---------- LLM / Embedding 凭证（必填）----------
# DeepSeek（推理模型）：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 阿里通义（Embedding）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 安全 ----------
# 生产环境务必改成长随机字符串，否则 JWT 可被伪造
JWT_SECRET=please-change-me-to-long-random-string

# ---------- Tavily Search API（Web 搜索）----------
# 注册 https://app.tavily.com 获取免费 API Key（1000 次/月）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 可选 ----------
# 默认即可
# LLM_PROVIDER=deepseek
# EMBEDDING_PROVIDER=tongyi
