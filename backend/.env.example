# ============================================================
# NexusAI 后端环境变量配置（示例）
# 使用方法：复制本文件为 .env，并填入真实值
# ============================================================

# ---------- 应用基础配置 ----------
APP_NAME=NexusAI
APP_ENV=development                # development / production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=True

# ---------- JWT 认证配置 ----------
# 生产环境务必使用复杂密钥（可用 openssl rand -hex 32 生成）
JWT_SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 默认 24 小时

# ---------- PostgreSQL 数据库 ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexus_ai

# ---------- Redis（Celery Broker + 缓存） ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Celery 配置 ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- CORS 跨域 ----------
# 多个域名用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# 以下为后续阶段使用，阶段一可暂时不填
# ============================================================

# ---------- DeepSeek API（阶段三）----------
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro            # 重型模型：Tool Agent、Skills 等复杂推理
DEEPSEEK_MODEL_FAST=deepseek-v4-flash     # 轻型模型：Router、闲聊、RAG 等简单任务

# ---------- 阿里通义 Embedding API（阶段二）----------
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# ---------- ChromaDB（阶段二）----------
CHROMA_PERSIST_DIR=./data/chroma

# ---------- 文件上传配置（阶段二）----------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
