# ============================================================
# 项目级 .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
*.whl

# ---------- 虚拟环境 ----------
venv/
.venv/
env/
ENV/

# ---------- 环境变量（不能提交真实密钥）----------
.env
.env.local
.env.*.local
!.env.example

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 测试与覆盖率 ----------
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---------- 日志 ----------
logs/
*.log

# ---------- 数据目录（运行时生成）----------
backend/data/
backend/uploads/
backend/chroma_db/

# ---------- 前端 ----------
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ---------- Alembic（迁移文件保留，缓存忽略）----------
backend/alembic/__pycache__/
